# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL (used by the backend)
REDIS_URL=redis://localhost:6379/0

# Behavior when Redis is unreachable:
# "open"   = allow requests (fail open, higher availability, some over-limit risk)
# "closed" = block requests (fail closed, strict enforcement, availability impact)
FAIL_MODE=open

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file for client plan-tier storage
DATABASE_URL=sqlite:///./rate_limiter.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the browser dashboard
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
